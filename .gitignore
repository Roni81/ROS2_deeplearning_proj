# ----------------------------------
# 1. Python 필수 제외 (컴파일된 파일들)
# ----------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd

# ----------------------------------
# 2. 가상환경 폴더 (용량이 매우 큼)
# ----------------------------------
env/
venv/
.env
.venv/

# ----------------------------------
# 3. 데이터 및 결과물 제외 (중요!)
# ----------------------------------
# 분석용 원본 데이터나 결과물이 너무 많다면 업로드 제외 추천
*.json
*.csv
*.npy
*.mp4
*.avi
stgcn_dataset.pkl


# 이미지 파일들도 제외하고 싶다면 주석 해제
# *.jpg
# *.png

# 특정 폴더 통째로 제외 (예: 결과 폴더)
result/
output/
data/
dataset/

# ----------------------------------
# 4. 편집기/OS 설정 파일
# ----------------------------------
.vscode/
.idea/
.DS_Store
